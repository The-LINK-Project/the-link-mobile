{
  "name": "the-link-mobile",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace @link/api",
    "dev:mobile": "npm run start --workspace @link/mobile",
    "android": "npm run android --workspace @link/mobile",
    "ios": "npm run ios --workspace @link/mobile",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "smoke:live": "npm run smoke:live --workspace @link/api",
    "smoke:tutor": "npm run smoke:tutor --workspace @link/api",
    "eval:tutor": "npm run eval:tutor --workspace @link/api",
    "build:api": "npm run build --workspace @link/api",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,json}\" \"apps/*/test/**/*.ts\" \"apps/*/*.{js,json}\" \"*.json\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx,json}\" \"apps/*/test/**/*.ts\" \"apps/*/*.{js,json}\" \"*.json\""
  },
  "devDependencies": {
    "prettier": "3.9.6"
  },
  "dependencies": {
    "expo-haptics": "~57.0.3",
    "expo-speech": "~57.0.3"
  }
}
